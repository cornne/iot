{
  "version": 1,
  "author": "ScAllergen Smart IoT",
  "editor": "wokwi",
  "parts": [
    {
      "type": "board-esp32-devkit-c-v4",
      "id": "esp",
      "top": 0,
      "left": 0,
      "attrs": {}
    },
    {
      "type": "wokwi-lcd1602",
      "id": "lcd1",
      "top": -90,
      "left": 230,
      "attrs": {
        "pins": "i2c"
      }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "btn1",
      "top": 90,
      "left": 230,
      "attrs": {
        "color": "green",
        "label": "CAPTURE / SEND"
      }
    },
    {
      "type": "wokwi-led",
      "id": "led_red",
      "top": 90,
      "left": 360,
      "attrs": {
        "color": "red",
        "label": "ALLERGEN ALERT"
      }
    },
    {
      "type": "wokwi-resistor",
      "id": "r_red",
      "top": 140,
      "left": 360,
      "attrs": {
        "resistance": "220"
      }
    },
    {
      "type": "wokwi-led",
      "id": "led_green",
      "top": 90,
      "left": 450,
      "attrs": {
        "color": "green",
        "label": "SAFE / READY"
      }
    },
    {
      "type": "wokwi-resistor",
      "id": "r_green",
      "top": 140,
      "left": 450,
      "attrs": {
        "resistance": "220"
      }
    },
    {
      "type": "wokwi-buzzer",
      "id": "bz1",
      "top": 200,
      "left": 360,
      "attrs": {
        "volume": "0.1"
      }
    }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "esp:GND.1", "lcd1:GND", "black", [ "v0" ] ],
    [ "esp:5V", "lcd1:VCC", "red", [ "v0" ] ],
    [ "esp:22", "lcd1:SCL", "gold", [ "v0" ] ],
    [ "esp:21", "lcd1:SDA", "blue", [ "v0" ] ],
    [ "esp:GND.2", "btn1:1.l", "black", [ "v0" ] ],
    [ "esp:4", "btn1:2.l", "green", [ "v0" ] ],
    [ "esp:13", "led_red:A", "red", [ "v0" ] ],
    [ "led_red:C", "r_red:1", "black", [ "v0" ] ],
    [ "r_red:2", "esp:GND.3", "black", [ "v0" ] ],
    [ "esp:2", "led_green:A", "green", [ "v0" ] ],
    [ "led_green:C", "r_green:1", "black", [ "v0" ] ],
    [ "r_green:2", "esp:GND.3", "black", [ "v0" ] ],
    [ "esp:14", "bz1:2", "purple", [ "v0" ] ],
    [ "bz1:1", "esp:GND.3", "black", [ "v0" ] ]
  ],
  "dependencies": {}
}
