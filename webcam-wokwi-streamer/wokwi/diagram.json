    [ "r_green:2", "esp:GND.3", "black", [ "v0" ] ],

    [ "esp:GND.2", "lcd1:GND", "black", [ "v0" ] ],
    [ "esp:5V", "lcd1:VCC", "red", [ "v0" ] ],
    [ "esp:22", "lcd1:SCL", "gold", [ "v0" ] ],
    [ "esp:21", "lcd1:SDA", "blue", [ "v0" ] ]
  ],
  "dependencies": {}
